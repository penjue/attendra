NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://attendra:attendra@localhost:5432/attendra
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Tablet QR destination; optional in production (defaults to https://attendra.co.ke).
VITE_EMPLOYEE_APP_URL=http://localhost:5173

# Read-only support assistant. Enable only on the intended staging API.
ATTENDRA_SUPPORT_ENABLED=false
# Set the real key securely in the staging service environment, never in Git.
ATTENDRA_SUPPORT_OPENAI_KEY=
ATTENDRA_SUPPORT_MODEL=gpt-4.1-mini
